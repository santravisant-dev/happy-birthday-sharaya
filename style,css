*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:linear-gradient(135deg,#ff9ec4,#ffd6e7,#fff0f6);
height:100vh;
overflow:hidden;
}

.screen{
width:100%;
height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
}

.hidden{
display:none;
}

h1{
font-size:55px;
color:#d81b60;
margin-bottom:20px;
}

h2{
margin-top:20px;
color:#6a1b9a;
}

p{
font-size:22px;
margin-bottom:20px;
}

.buttons{
margin-top:30px;
}

button{
padding:15px 35px;
margin:15px;
border:none;
border-radius:50px;
font-size:22px;
cursor:pointer;
transition:.3s;
}

#yesBtn{
background:#ff4081;
color:white;
}

#noBtn{
background:#555;
color:white;
position:absolute;
}

#balloons{
display:flex;
gap:40px;
margin-top:40px;
}

.balloon{
font-size:90px;
cursor:pointer;
transition:.3s;
}

.balloon:hover{
transform:scale(1.2);
}

.red{
color:red;
}

.blue{
color:dodgerblue;
}

.green{
color:limegreen;
}

.yellow{
color:gold;
}
